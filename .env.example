# Copiar este archivo a .env (no se sube al repo) si quieren usar
# credenciales distintas a las que trae docker-compose.yml por defecto.
# Si no crean el .env, se usan los valores por defecto: turnero/turnero/turnero.

POSTGRES_USER=turnero
POSTGRES_PASSWORD=turnero
POSTGRES_DB=turnero
POSTGRES_PORT=5432
